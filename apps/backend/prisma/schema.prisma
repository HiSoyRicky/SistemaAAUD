generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model bd_incidents {
  id                                      Int               @id(map: "pk_incidents") @default(autoincrement())
  id_user                                 Int
  reporter_name                           String            @db.VarChar(35)
  email                                   String?           @db.VarChar(50)
  id_ubication                            Int
  id_department                           Int
  description                             String            @db.VarChar(255)
  id_category                             Int
  other_category_detail                   String?           @db.VarChar(50)
  creation_date                           DateTime
  id_status                               Int
  id_technician                           Int?
  solution_date                           DateTime?
  solution                                String            @db.VarChar(255)
  client_ip                               String?           @db.VarChar(50)
  ticket_number                           Int               @unique(map: "bd_incidents_ticket_unique") @default(autoincrement())
  categories                              categories        @relation(fields: [id_category], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bd_incidents_categories")
  departments                             departments       @relation(fields: [id_department], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bd_incidents_departments")
  status                                  status            @relation(fields: [id_status], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bd_incidents_status")
  ubications                              ubications        @relation(fields: [id_ubication], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bd_incidents_ubications")
  users_bd_incidents_id_userTousers       users             @relation("bd_incidents_id_userTousers", fields: [id_user], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bd_incidents_users")
  users_bd_incidents_id_technicianTousers users?            @relation("bd_incidents_id_technicianTousers", fields: [id_technician], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bd_incidents_users1")
  toner_movements                         toner_movements[] @relation("IncidentTonerMovements")
}

model bd_inventory {
  id                     Int       @id(map: "pk_bd_inventory") @default(autoincrement())
  tag                    String    @db.VarChar(50)
  id_ubication           Int?
  id_department          Int?
  user                   String?   @db.VarChar(50)
  description            String?   @db.VarChar(255)
  id_device              Int
  id_brand               Int
  id_model               Int
  serie                  String    @db.VarChar(50)
  ip                     String?   @db.VarChar(50)
  id_status              Int
  id_condition           Int?
  id_administrative_area Int?
  transferdate           DateTime? @db.Date
  observation            String?   @db.VarChar(255)
  created_by             Int?
  created_at             DateTime? @db.Timetz(6)
  updated_at             DateTime? @db.Timetz(6)
  updated_by             Int?

  transfer_requests inventory_transfer_requests[]

  brands              brands                          @relation(fields: [id_brand], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bd_inventory_brands")
  departments         departments?                    @relation(fields: [id_department], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bd_inventory_departments")
  devices             devices                         @relation(fields: [id_device], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bd_inventory_devices")
  models              models                          @relation(fields: [id_model], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bd_inventory_models")
  status              status                          @relation(fields: [id_status], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bd_inventory_status")
  condition           inventory_conditions?           @relation(fields: [id_condition], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bd_inventory_condition")
  administrative_area inventory_administrative_areas? @relation(fields: [id_administrative_area], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bd_inventory_administrative_area")
  ubications          ubications?                     @relation(fields: [id_ubication], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bd_inventory_ubications")

  inventory_devices inventory_devices?
}

model inventory_conditions {
  id          Int            @id @default(autoincrement())
  name        String         @unique @db.VarChar(50)
  inventories bd_inventory[]
}

model inventory_administrative_areas {
  id          Int            @id @default(autoincrement())
  name        String         @unique @db.VarChar(100)
  inventories bd_inventory[]
}

model inventory_product_catalog {
  id              Int                          @id @default(autoincrement())
  codigo_producto String                       @unique @db.VarChar(50)
  titulo_espanol  String                       @db.VarChar(255)
  titulo_ingles   String?                      @db.VarChar(255)
  activo          Boolean                      @default(true)
  created_at      DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime                     @updatedAt @db.Timestamptz(6)
  synonyms        inventory_product_synonyms[]
}

model inventory_product_synonyms {
  id                 Int      @id @default(autoincrement())
  product_id         Int
  synonym            String   @db.Text
  synonym_normalized String   @db.Text
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @updatedAt @db.Timestamptz(6)

  product inventory_product_catalog @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, synonym_normalized])
  @@index([product_id])
  @@index([synonym_normalized])
}

model inventory_devices {
  id           Int      @id @default(autoincrement())
  id_inventory Int      @unique
  id_device    Int
  id_brand     Int
  id_model     Int
  ip           String?  @db.VarChar(45)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)

  inventory bd_inventory @relation(fields: [id_inventory], references: [id], onDelete: Cascade)
  device    devices      @relation(fields: [id_device], references: [id])
  brand     brands       @relation(fields: [id_brand], references: [id])
  model     models       @relation(fields: [id_model], references: [id])

  @@index([id_device])
  @@index([id_brand])
  @@index([id_model])
}

model brands {
  id                Int                 @id(map: "pk_brands") @default(autoincrement())
  name              String              @unique @db.VarChar(50)
  bd_inventory      bd_inventory[]
  models            models[]
  inventory_devices inventory_devices[]
}

model categories {
  id           Int            @id(map: "pk_category") @default(autoincrement())
  name         String         @db.VarChar(50)
  bd_incidents bd_incidents[]
}

model departments {
  id              Int               @id(map: "pk_department") @default(autoincrement())
  name            String            @db.VarChar(50)
  id_ubication    Int?
  bd_incidents    bd_incidents[]
  bd_inventory    bd_inventory[]
  ubications      ubications?       @relation(fields: [id_ubication], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_departments_ubications")
  toner_movements toner_movements[] @relation("DepartmentTonerMovements")
  users           users[]
}

model devices {
  id                Int                 @id(map: "pk_device") @default(autoincrement())
  name              String              @unique(map: "name_devices_unique") @db.VarChar(50)
  bd_inventory      bd_inventory[]
  models            models[]
  inventory_devices inventory_devices[]
}

model models {
  id                Int                 @id(map: "pk_models") @default(autoincrement())
  name              String              @db.VarChar(50)
  id_brand          Int
  id_device         Int
  bd_inventory      bd_inventory[]
  brands            brands              @relation(fields: [id_brand], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_models_brands")
  devices           devices             @relation(fields: [id_device], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_models_devices")
  toners            toners[]
  inventory_devices inventory_devices[]
}

model roles {
  id              Int                @id(map: "pk_roles") @default(autoincrement())
  name            String             @unique(map: "name_roles_unique") @db.VarChar(50)
  users           users[]
  rolePermissions role_permissions[]
}

model status {
  id           Int            @id(map: "pk_status") @default(autoincrement())
  name         String         @db.VarChar(50)
  bd_incidents bd_incidents[]
  bd_inventory bd_inventory[]
}

model ubications {
  id              Int               @id(map: "pk_ubication") @default(autoincrement())
  name            String            @unique(map: "name_ubications_unique") @db.VarChar(50)
  bd_incidents    bd_incidents[]
  bd_inventory    bd_inventory[]
  departments     departments[]
  toner_movements toner_movements[] @relation("UbicationTonerMovements")
  users           users[]
}

model users {
  id                                             Int                           @id(map: "pk_users") @default(autoincrement())
  nombre_completo                                String                        @db.VarChar(50)
  username                                       String                        @db.VarChar(50)
  password                                       String?                       @db.VarChar(255)
  email                                          String?                       @db.VarChar(50)
  id_rol                                         Int
  active                                         Boolean                       @default(false)
  id_department                                  Int?
  id_ubication                                   Int?
  must_change_password                           Boolean                       @default(false)
  activityLogs                                   activity_logs[]
  bd_incidents_bd_incidents_id_userTousers       bd_incidents[]                @relation("bd_incidents_id_userTousers")
  bd_incidents_bd_incidents_id_technicianTousers bd_incidents[]                @relation("bd_incidents_id_technicianTousers")
  toner_movements                                toner_movements[]             @relation("UserTonerMovements")
  inventory_transfer_requests_requested          inventory_transfer_requests[] @relation("InventoryTransferRequester")
  inventory_transfer_requests_reviewed           inventory_transfer_requests[] @relation("InventoryTransferApprover")
  departments                                    departments?                  @relation(fields: [id_department], references: [id], map: "fk_users_departments")
  roles                                          roles                         @relation(fields: [id_rol], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_roles")
  user_permissions                               user_permissions[]
  ubications                                     ubications?                   @relation(fields: [id_ubication], references: [id], map: "fk_users_ubications")

  @@unique([nombre_completo, username, email], map: "name_users_unique")
}

model toners {
  id               Int               @id(map: "pk_toners") @default(autoincrement())
  color            TonerColor
  toner_model      String?           @db.VarChar(20)
  id_printer_model Int?
  min_stock        Int               @default(0)
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  movements        toner_movements[]
  stock            toner_stock?
  models           models?           @relation(fields: [id_printer_model], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model toner_movements {
  id                   Int                  @id @default(autoincrement())
  id_toner             Int
  quantity             Int
  movement_type        TonerMovementType
  id_user              Int?
  id_department        Int?
  id_ubication         Int?
  reference            String?              @db.VarChar(100)
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  created_by           Int?
  id_incident          Int?
  new_stock            Int
  previous_stock       Int
  document_status      TonerDocumentStatus? @default(PENDING)
  document_uploaded_at DateTime?            @db.Timestamptz(6)
  document_uploaded_by Int?
  receiver_name        String?              @db.VarChar(100)
  signed_document      String?              @db.VarChar(255)
  department           departments?         @relation("DepartmentTonerMovements", fields: [id_department], references: [id])
  incident             bd_incidents?        @relation("IncidentTonerMovements", fields: [id_incident], references: [id])
  toner                toners               @relation(fields: [id_toner], references: [id])
  ubication            ubications?          @relation("UbicationTonerMovements", fields: [id_ubication], references: [id])
  user                 users?               @relation("UserTonerMovements", fields: [id_user], references: [id])

  @@index([id_toner])
  @@index([id_department])
  @@index([id_ubication])
}

model toner_stock {
  id         Int      @id @default(autoincrement())
  id_toner   Int      @unique
  quantity   Int      @default(0)
  updated_at DateTime @updatedAt
  toner      toners   @relation(fields: [id_toner], references: [id])
}

model activity_logs {
  id          Int            @id @default(autoincrement())
  entity_type String?        @db.VarChar(50)
  entity_id   Int?
  action      ActivityAction
  old_values  Json?
  new_values  Json?
  user_id     Int?
  ip_address  String?        @db.VarChar(50)
  user_agent  String?        @db.VarChar(255)
  source      String?        @db.VarChar(50)
  created_at  DateTime       @default(now())
  user        users?         @relation(fields: [user_id], references: [id])

  @@index([entity_type, entity_id])
  @@index([user_id])
  @@index([created_at])
}

enum TonerMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum TonerColor {
  BLACK
  CYAN
  MAGENTA
  YELLOW
  TRI_COLOR
}

enum TonerDocumentStatus {
  PENDING
  SIGNED
  REJECTED
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  ASSIGN
  STATUS_CHANGE
  LOGIN
  LOGOUT
}

enum InventoryTransferRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CORRECTION_REQUESTED
}

model inventory_transfer_requests {
  id           Int                            @id @default(autoincrement())
  inventory_id Int
  requester_id Int
  approver_id  Int?
  status       InventoryTransferRequestStatus @default(PENDING)
  snapshot     Json
  review_notes String?                        @db.Text
  requested_at DateTime                       @default(now()) @db.Timestamptz(6)
  reviewed_at  DateTime?                      @db.Timestamptz(6)

  inventory bd_inventory @relation(fields: [inventory_id], references: [id], onDelete: Cascade, map: "fk_inventory_transfer_requests_inventory")
  requester users        @relation("InventoryTransferRequester", fields: [requester_id], references: [id], onDelete: Restrict, map: "fk_inventory_transfer_requests_requester")
  approver  users?       @relation("InventoryTransferApprover", fields: [approver_id], references: [id], onDelete: SetNull, map: "fk_inventory_transfer_requests_approver")

  @@index([status, requested_at])
  @@index([inventory_id])
  @@map("inventory_transfer_requests")
}

model permissions {
  id     Int    @id @default(autoincrement())
  module String
  action String

  role_permissions role_permissions[]
  user_permissions user_permissions[]

  @@unique([module, action])
}

model role_permissions {
  id_permission Int
  id_role       Int

  permission permissions @relation(fields: [id_permission], references: [id])
  role       roles       @relation(fields: [id_role], references: [id])

  @@id([id_permission, id_role])
}

model user_permissions {
  id_user       Int
  id_permission Int
  allow         Boolean @default(true)

  user       users       @relation(fields: [id_user], references: [id])
  permission permissions @relation(fields: [id_permission], references: [id])

  @@id([id_user, id_permission])
}
