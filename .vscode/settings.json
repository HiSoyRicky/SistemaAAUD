{
  "js/ts.updateImportsOnFileMove.enabled": "always",

  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabCompletion": "on",
  "editor.rulers": [80, 120],
  "editor.minimap.enabled": false,
  "editor.inlineSuggest.enabled": true,

  "editor.codeActionsOnSave": {
    "source.fixAll": "always",
    "source.organizeImports": "always"
  },

  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "explorer.confirmDelete": false,

  "sqltools.connections": [
    {
      "ssh": "Disabled",
      "previewLimit": 50,
      "server": "localhost",
      "port": 5432,
      "askForPassword": true,
      "driver": "PostgreSQL",
      "name": "Sistema AAUD LOCAL",
      "database": "aaud_system",
      "username": "postgres"
    }
  ],

  "cSpell.words": [
    "aaud",
    "Cian",
    "codigo",
    "datasource",
    "exceljs",
    "hsts",
    "imapflow",
    "INFORMATICA",
    "inutilización",
    "mailparser",
    "nums",
    "officedocument",
    "openxmlformats",
    "originalname",
    "postgresql",
    "Prisma",
    "reconectado",
    "Segoe",
    "spreadsheetml",
    "Tahoma",
    "tecnico",
    "Timetz",
    "Toastify",
    "toners",
    "Tóners",
    "Tousers",
    "transferdate",
    "ubication",
    "Ubication",
    "ubications",
    "unico",
    "uuidv",
    "Verdana"
  ],

  "cSpell.ignoreWords": ["Timestamptz", "autoincrement"]
}
